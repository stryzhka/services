{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/swagger"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "auth-swagger-sub": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "auth-openapi": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/openapi/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "words": {
        "ClusterId": "objects-cluster",
        "Match": {
          "Path": "/api/words/{**catch-all}"
        }
      },
      "categories": {
        "ClusterId": "objects-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-1": {
            "Address": "http://auth-service:5018/"
          }
        }
      },
      "objects-cluster": {
        "Destinations": {
          "objects-1": {
            "Address": "http://objects-service:8080/"
          }
        }
      }
    }
  }
}
